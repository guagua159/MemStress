# 构建产物：exe 与 tools/、logs/ 同级是分发形态，不入库
/MemStress.exe
/MemStress.dll
/MemStress.pdb
/MemStress.deps.json
/MemStress.runtimeconfig.json

# 中间产物
obj/
bin/
src/**/obj/
src/**/bin/

# 运行期产物
logs/

# 外部工具投放点：第三方二进制一律不入库（红线：不下载、不分发第三方二进制）
tools/

# 说明书由本地脚本生成，不入库
docs/*.docx

# 内部工作文档与个人开发工具，只留在本机，不随公开仓库分发
AGENTS.md
src/MemStress/AGENTS.md
src/MemStress/Core/AGENTS.md
MAINTENANCE.md
scripts/gui-smoke.ps1
scripts/gui-act.ps1
scripts/gui-selftest.ps1
scripts/make-manual.py

# docs/ 全部为本地内部文档（交接、审计、调研记录、截图、方案），不入库。
# 公开仓库只放源码、脚本与 README/CHANGELOG/MAINTENANCE。
docs/

# 编辑器与本地配置
.vs/
.idea/
*.user
*.suo

# Python 字节码（CI 的 py_compile 步骤会生成）
__pycache__/
*.pyc
